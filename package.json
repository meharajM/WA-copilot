{
    "name": "aica",
    "version": "1.0.1",
    "type": "module",
    "description": "Self-hosted WhatsApp AI agent for privacy-first business automation",
    "main": "./out/main/index.js",
    "author": "AIConsumerAgent Team",
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "electron-vite dev",
        "dev:tauri": "npm run prepare:agentd:keyring-helper && npm run prepare:agentd:migration-reader && npm run prepare:tauri:agentd && tauri dev",
        "dev:tauri:web": "vite --config vite.tauri.config.ts --host 127.0.0.1 --strictPort",
        "build": "electron-vite build",
        "build:tauri": "tauri build",
        "build:tauri:win": "tauri build --target x86_64-pc-windows-msvc",
        "build:tauri:web": "vite build --config vite.tauri.config.ts",
        "prepare:agentd:keyring-helper": "node scripts/prepare-agentd-keyring-helper.mjs",
        "prepare:agentd:migration-reader": "node scripts/prepare-agentd-migration-reader.mjs",
        "prepare:tauri:agentd": "node scripts/prepare-tauri-agentd.mjs",
        "preview": "electron-vite preview",
        "typecheck": "tsc --noEmit",
        "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
        "check:runtime": "node scripts/check-runtime-compat.cjs",
        "check:live-prereqs": "node scripts/check-live-prerequisites.cjs",
        "check:live-evidence": "node scripts/validate-live-evidence.mjs",
        "check:windows-resource-evidence": "node --test tests/unit/windows-resource-evidence.test.cjs",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "test": "vitest run",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:agentd": "node --test tests/unit/agentd.test.cjs",
        "test:agentd:speech": "node --test tests/unit/agentd-speech-model.test.cjs",
        "test:agentd:credentials": "node --test tests/unit/agentd-credential-store.test.cjs",
        "test:relay": "node --test tests/unit/public-relay.test.cjs",
        "agentd": "node scripts/agentd.cjs",
        "relay": "node scripts/public-relay.cjs",
        "agentd:pair-code": "node scripts/agentd-pair-code.cjs",
        "test:live": "LIVE_LLM_TESTS=true vitest run tests/live",
        "test:robust": "npm run test:unit && npm run test:integration && npm run test:live",
        "test:watch": "vitest",
        "test:e2e": "npm run test:playwright",
        "test:e2e:browser": "npm run build:tauri:web && node scripts/browser-e2e.cjs",
        "test:mock": "node tests/e2e/no-suite.cjs mock",
        "test:playwright": "npm run build && node scripts/electron-e2e.cjs",
        "test:e2e:packaged:mac": "npm run build:mac:qa && WA_COPILOT_E2E_EXECUTABLE=dist/qa-mac/mac-arm64/AIConsumerAgent.app/Contents/MacOS/AIConsumerAgent node tests/e2e/electron-smoke.cjs",
        "test:speech": "node tests/e2e/no-suite.cjs speech",
        "release:gate": "bash scripts/release-gate.sh",
        "clean": "rm -rf out dist",
        "clean:native:build": "rm -rf node_modules/better-sqlite3/build",
        "clean:state": "rm -rf ~/Library/Application\\ Support/WA-Co-Pilot",
        "dev:clean": "npm run clean && rm -rf node_modules/.vite tsconfig.tsbuildinfo && npm run clean:state && npm run dev",
        "check:wine": "command -v wine >/dev/null 2>&1 || { echo >&2 'Error: Wine is required for Windows builds on Mac or Linux. Please run ./install_build_deps.sh to install it.'; exit 1; }",
        "prebuild:electron": "node scripts/create-libsignal-shim.cjs",
        "rebuild:mac": "npm run prebuild:electron && npm run clean && npm run build && electron-builder --mac",
        "rebuild:mac:intel": "npm run prebuild:electron && npm run clean && npm run build && electron-builder --mac --x64",
        "rebuild:mac:arm": "npm run prebuild:electron && npm run clean && npm run build && electron-builder --mac --arm64",
        "rebuild:mac:universal": "npm run prebuild:electron && npm run clean && npm run clean:native:build && npm run build && electron-builder --mac --universal",
        "rebuild:win": "npm run prebuild:electron && npm run check:wine && npm run clean && npm run build && electron-builder --win",
        "rebuild:win:intel": "npm run prebuild:electron && npm run check:wine && npm run clean && npm run build && electron-builder --win --x64",
        "rebuild:win:arm": "npm run prebuild:electron && npm run check:wine && npm run clean && npm run build && electron-builder --win --arm64",
        "rebuild:linux": "npm run prebuild:electron && npm run clean && npm run build && electron-builder --linux",
        "rebuild:linux:intel": "npm run prebuild:electron && npm run clean && npm run build && electron-builder --linux --x64",
        "rebuild:linux:arm": "npm run prebuild:electron && npm run clean && npm run build && electron-builder --linux --arm64",
        "build:mac": "npm run prebuild:electron && npm run build && electron-builder --mac",
        "build:mac:qa": "bash scripts/build-mac-qa.sh",
        "build:mac:intel": "npm run prebuild:electron && npm run build && electron-builder --mac --x64",
        "build:mac:arm": "npm run prebuild:electron && npm run build && electron-builder --mac --arm64",
        "build:mac:universal": "npm run prebuild:electron && npm run clean:native:build && npm run build && electron-builder --mac --universal",
        "build:win": "npm run prebuild:electron && npm run check:wine && npm run build && electron-builder --win",
        "build:win:intel": "npm run prebuild:electron && npm run check:wine && npm run build && electron-builder --win --x64",
        "build:win:arm": "npm run prebuild:electron && npm run check:wine && npm run build && electron-builder --win --arm64",
        "build:linux": "npm run prebuild:electron && npm run build && electron-builder --linux",
        "build:linux:intel": "npm run prebuild:electron && npm run build && electron-builder --linux --x64",
        "build:linux:arm": "npm run prebuild:electron && npm run build && electron-builder --linux --arm64",
        "build:all": "./scripts/build.sh",
        "publish:mac": "bash scripts/publish-mac.sh",
        "publish:mac:universal": "bash scripts/publish-mac.sh --universal",
        "publish:linux": "bash scripts/publish-linux.sh",
        "publish:win": "bash scripts/publish-win.sh",
        "publish:all": "bash scripts/publish-all.sh"
    },
    "dependencies": {
        "@electron-toolkit/utils": "^3.0.0",
        "@langchain/core": "1.2.9",
        "@langchain/langgraph": "1.4.14",
        "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
        "@mlc-ai/web-llm": "^0.2.80",
        "@modelcontextprotocol/sdk": "^1.0.1",
        "@modelcontextprotocol/server-memory": "^2025.11.25",
        "@tauri-apps/api": "^2.0.0",
        "@playwright/mcp": "^0.0.53",
        "@radix-ui/react-dialog": "^1.1.15",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@whiskeysockets/baileys": "^6.7.21",
        "@whiskeysockets/libsignal-node": "github:whiskeysockets/libsignal-node",
        "better-sqlite3": "^12.8.0",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "electron-store": "^11.0.2",
        "firebase": "^12.8.0",
        "fix-path": "^5.0.0",
        "formik": "^2.4.9",
        "framer-motion": "^12.26.2",
        "lucide-react": "^0.468.0",
        "playwright": "^1.57.0",
        "playwright-core": "^1.58.2",
        "playwright-extra": "^4.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "qrcode": "^1.5.4",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-markdown": "^10.1.0",
        "react-syntax-highlighter": "^16.1.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.4.0",
        "tree-kill": "^1.2.2",
        "vosk-browser": "^0.0.8",
        "yup": "^1.7.1",
        "zustand": "^5.0.9"
    },
    "devDependencies": {
        "@electron-toolkit/tsconfig": "^1.0.1",
        "@eslint/js": "^9.39.3",
        "@types/node": "^20.11.10",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^18.2.48",
        "@types/react-dom": "^18.2.18",
        "@vitejs/plugin-react": "^4.2.1",
        "@tauri-apps/cli": "^2.0.0",
        "autoprefixer": "^10.4.17",
        "dotenv": "^17.3.1",
        "electron": "^44.3.0",
        "electron-builder": "^26.4.0",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.3",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.5.0",
        "node-abi": "^4.35.0",
        "postcss": "^8.4.35",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.56.1",
        "vite": "^7.3.1",
        "vitest": "^4.1.2"
    },
    "overrides": {
        "protobufjs": "7.6.6",
        "uuid": "11.1.1"
    },
    "build": {
        "appId": "com.aica.app",
        "productName": "AIConsumerAgent",
        "directories": {
            "output": "dist"
        },
        "files": [
            "out/**/*",
            "!out/**/*.map"
        ],
        "asarUnpack": [
            "node_modules/@whiskeysockets/baileys/**/*",
            "node_modules/@whiskeysockets/libsignal-node/**/*",
            "node_modules/libsignal/**/*"
        ],
        "mac": {
            "target": [
                "dmg",
                "zip"
            ],
            "category": "public.app-category.productivity",
            "icon": "build/icon.png",
            "hardenedRuntime": true,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.inherit.plist"
        },
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "build/icon.png",
            "publish": {
                "provider": "generic",
                "url": "https://downloads.aica.tech"
            }
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Utility",
            "icon": "build/icon.png",
            "maintainer": "AIConsumerAgent Team <support@aica.tech>",
            "publish": {
                "provider": "generic",
                "url": "https://downloads.aica.tech"
            }
        },
        "extraResources": [
            {
                "from": "scripts",
                "to": "scripts",
                "filter": [
                    "setup-dependencies.sh",
                    "setup-dependencies.ps1"
                ]
            }
        ],
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}
