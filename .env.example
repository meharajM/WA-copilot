# Local test configuration (copy to .env or .env.test)
# Keep LIVE_LLM_TESTS=false for regular fast unit runs.

LIVE_LLM_TESTS=false
LIVE_EXPECT_NATIVE_TOOLS=true

# OpenRouter live test credentials
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gmail OAuth (app-managed for desktop builds)
# End users should NOT input these manually in UI.
GMAIL_OAUTH_CLIENT_ID=replace_with_google_desktop_client_id
GMAIL_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret
